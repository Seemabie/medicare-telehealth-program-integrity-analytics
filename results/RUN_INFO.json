{
  "project": "Medicare Telehealth Fraud and Utilization Analytics",
  "version": "REBUILD V3",
  "rebuild_started": "2026-05-14",
  "principal_investigator": "Seemab Hassan",
  "methodology_framing": "Anomaly detection and risk stratification of Medicare telehealth billing patterns. NOT supervised fraud classification.",
  "validation_strategy": "Six pillars: bootstrap CI, permutation importance, temporal holdout, OIG LEIE concordance (honest), DOJ cross reference (honest), fraud typology alignment, threshold sensitivity.",
  "risk_score_interpretation": "Anomaly score (0 to 100) indicating statistical deviation from peer billing patterns. NOT a fraud probability. Investigative review by appropriate authorities required before any inference.",
  "data_window": "2019 to 2023 Medicare Provider and Service files (HCPCS-level), analytical universe is 2023",
  "analytical_universe_definition": "Providers billing any code from the 27 code telehealth HCPCS basket in 2023, with row-level filters Tot_Benes>=11 and Avg_Mdcr_Pymt_Amt>0",
  "parameters": {
    "random_seed": 42,
    "isolation_forest_contamination": 0.02,
    "isolation_forest_n_estimators": 100,
    "isolation_forest_bootstrap": false,
    "statistical_weights": {
      "Payment_Per_Bene": 0.3,
      "Services_Per_Bene": 0.25,
      "Avg_Payment_Per_Service": 0.15,
      "Audio_Only_Share": 0.1,
      "Telehealth_HCPCS_Diversity": 0.1,
      "Log_Services": 0.1
    },
    "combined_score_weights": {
      "statistical": 0.6,
      "ml": 0.4
    },
    "tier_cutpoints_percentile": {
      "Low": "<80",
      "Medium": "80-95",
      "High": "95-99",
      "Critical": "99-99.9",
      "Extreme": "99.9+"
    },
    "flagged_set_definition": "percentile >= 95 (top 5 percent by Combined_Risk_Score)",
    "bootstrap_iterations": 1000,
    "permutation_repeats": 5,
    "fuzzy_similarity_threshold": 0.85
